/*+ exists */
SELECT COUNT(*) AS count FROM k8s.apps.deployments
WHERE namespace = '{{ namespace }}'
  AND cluster_addr = '{{ cluster_addr }}'
  AND protocol = '{{ protocol }}'
  AND json_extract(metadata, '$.name') = '{{ name }}'

/*+ create */
INSERT INTO k8s.apps.deployments(namespace, cluster_addr, protocol, metadata, spec)
SELECT
  '{{ namespace }}',
  '{{ cluster_addr }}',
  '{{ protocol }}',
  '{"name": "{{ name }}", "namespace": "{{ namespace }}", "labels": {"app": "{{ name }}", "tier": "{{ tier }}", "{{ demo_label_key }}": "{{ demo_label_value }}", "managed-by": "stackql-deploy"}}',
  '{
    "replicas": {{ replicas }},
    "selector": {"matchLabels": {"app": "{{ name }}"}},
    "template": {
      "metadata": {"labels": {"app": "{{ name }}", "tier": "{{ tier }}", "{{ demo_label_key }}": "{{ demo_label_value }}"}},
      "spec": {"containers": [{
        "name": "{{ name }}",
        "image": "{{ image }}",
        "ports": [{"containerPort": {{ container_port }}, "name": "http"}],
        "resources": {"requests": {"cpu": "{{ cpu_request }}", "memory": "{{ memory_request }}"}, "limits": {"memory": "{{ memory_limit }}"}}
      }]}
    }
  }'

/*+ statecheck, retries=3, retry_delay=4 */
SELECT COUNT(*) AS count FROM (
  SELECT json_extract(metadata, '$.name') AS name,
         CAST(json_extract(spec, '$.replicas') AS REAL) AS want,
         CAST(coalesce(json_extract(status, '$.readyReplicas'), 0) AS REAL) AS ready,
         json_extract(spec, '$.template.spec.containers[0].image') AS image
  FROM k8s.apps.deployments
  WHERE namespace = '{{ namespace }}'
    AND cluster_addr = '{{ cluster_addr }}'
    AND protocol = '{{ protocol }}'
) t
WHERE t.name = '{{ name }}'
  AND t.want = {{ replicas }}
  AND t.ready = {{ replicas }}
  AND t.image = '{{ image }}'

/*+ update */
UPDATE k8s.apps.deployments
SET spec = '{
    "replicas": {{ replicas }},
    "template": {
      "spec": {"containers": [{
        "name": "{{ name }}",
        "image": "{{ image }}",
        "ports": [{"containerPort": {{ container_port }}, "name": "http"}],
        "resources": {"requests": {"cpu": "{{ cpu_request }}", "memory": "{{ memory_request }}"}, "limits": {"memory": "{{ memory_limit }}"}}
      }]}
    }
  }'
WHERE name = '{{ name }}'
  AND namespace = '{{ namespace }}'
  AND cluster_addr = '{{ cluster_addr }}'
  AND protocol = '{{ protocol }}'

/*+ delete */
DELETE FROM k8s.apps.deployments
WHERE name = '{{ name }}'
  AND namespace = '{{ namespace }}'
  AND cluster_addr = '{{ cluster_addr }}'
  AND protocol = '{{ protocol }}'
