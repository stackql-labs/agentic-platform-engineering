# copy to .env and fill in. The scripts source it; stackql-deploy reads it with
# --env-file .env; the agent loads it itself. Never commit .env.

# --- the model --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5 keeps a live run short; claude-opus-5-5 for a more careful report.
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Thinking is always on for the Claude 5 family;
# effort is the latency and cost control.
ANTHROPIC_EFFORT=medium

# --- the platform: StackQL MCP server ----------------------------------------
# read_only: writes refused by the server. safe: writes pause for operator approval.
# The agent code never starts a full_access server.
STACKQL_MCP_MODE=read_only
# where providers are pulled to; k8s and github must be there (REGISTRY PULL k8s;
# REGISTRY PULL github). Default is ~/.stackql.
STACKQL_APPROOT=
# an existing stackql binary for the npm launcher to use instead of downloading one
# (for example "C:/Program Files/StackQL/stackql.exe", quoted because of the space)
STACKQL_MCP_BIN=
# the server writes its audit sink (stackql_mcp_server_<timestamp>.jsonl, one JSON record
# per tool call, next to the run's transcript) into this directory. Default is runs/ under
# the demo directory. `npm run audit` renders the newest one.
STACKQL_AUDIT_DIR=
# cap on model steps per run (each tool call round trip is a step)
AGENT_MAX_STEPS=24
# production posture: never offer the write tools to the model (default false, so the
# server's refusal is what you see on screen)
AGENT_HIDE_WRITE_TOOLS=false
# newest MCP revision the server advertises; auto is fine (see agent.ts for why discovery is off)
STACKQL_MCP_PROTOCOL_VERSION=auto

# --- the estate: kind cluster via kubectl proxy --------------------------------
KIND_CLUSTER=platform-demo
# optional node image for kind create cluster. Docker Desktop on cgroup v1 cannot
# bootstrap kind's newest default image; kindest/node:v1.33.1 works there.
KIND_NODE_IMAGE=
KUBE_CLUSTER_ADDR=localhost:8001
KUBE_PROTOCOL=http
K8S_NAMESPACE=shop
# the stackql-deploy entry point, if it is not on PATH
# (Windows: C:/Users/<you>/AppData/Roaming/Python/Python312/Scripts/stackql-deploy.exe)
STACKQL_DEPLOY=
