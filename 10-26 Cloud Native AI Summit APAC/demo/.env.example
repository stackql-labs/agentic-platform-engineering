# copy to .env and fill in; source with export semantics before running anything:
#   set -a; source .env; set +a
# stackql-deploy reads it with --env-file .env; the agent loads it itself.

# Fixture and offline mode need no environment variables.
# Live model mode is opt-in: npm run agent requires --live-model and OPENAI_API_KEY.
OPENAI_API_KEY=
# Verified in current official OpenAI model/function-calling documentation.
# Do not replace with a different model family or silently fall back.
# Verified IDs: gpt-6-astra, gpt-6.1-sol, gpt-6-luna. Availability is account-specific.
OPENAI_MODEL=gpt-6-astra
# read_only prevents execution. safe requires interactive exact-plan confirmation.
DEMO_POLICY_MODE=read_only

# Retained StackQL/kind stack example; scripts require explicit disposable-cluster
# confirmation and are not used by the fixture agent.
KIND_CLUSTER=platform-demo
KUBE_CLUSTER_ADDR=localhost:8001
KUBE_PROTOCOL=http
K8S_NAMESPACE=shop
STACKQL_APPROOT=
