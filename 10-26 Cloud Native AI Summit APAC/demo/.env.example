# copy to .env and fill in; source with export semantics before running anything:
#   set -a; source .env; set +a
# stackql-deploy reads it with --env-file .env; the agent loads it itself.

# --- the model --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 is the default. claude-sonnet-5-5 is faster for a live demo.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Thinking is always on for the Claude 5 family;
# effort is the latency and cost control. medium is the API default for claude-opus-5-5.
ANTHROPIC_EFFORT=medium

# --- the platform: StackQL MCP server ----------------------------------------
# read_only: writes refused by the server. safe: writes pause for operator approval.
# The agent code never starts a full_access server.
STACKQL_MCP_MODE=read_only
# where providers are pulled to; the npm launcher, stackql on PATH and this demo
# all need to agree. Default is ~/.stackql.
STACKQL_APPROOT=
# the server writes its audit sink (stackql_mcp_server_<timestamp>.log, one JSON line
# per tool call) into this directory. Default is runs/ under the demo directory.
STACKQL_AUDIT_DIR=
# optional: an existing stackql binary for the npm launcher to use instead of
# downloading one (for example C:/Program Files/StackQL/stackql.exe)
STACKQL_MCP_BIN=
# cap on model steps per run (each tool call round trip is a step)
AGENT_MAX_STEPS=24
# production posture: never offer the write tools to the model (default false, so the
# server's refusal is what you see on screen)
AGENT_HIDE_WRITE_TOOLS=false
# newest MCP revision the server advertises; auto is fine (see agent.ts for why discovery is off)
STACKQL_MCP_PROTOCOL_VERSION=auto

# --- the estate: kind cluster via kubectl proxy --------------------------------
KIND_CLUSTER=platform-demo
KUBE_CLUSTER_ADDR=localhost:8001
KUBE_PROTOCOL=http
K8S_NAMESPACE=shop
