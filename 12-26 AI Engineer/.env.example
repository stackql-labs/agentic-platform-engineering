# copy to .env and fill in. Every version of the talk reads this file: each demo loads .env
# from its own folder first, then from its talk folder, then from here. Never commit .env.

# --- the model: the OpenAI SDK, Responses API -----------------------------------------
OPENAI_API_KEY=sk-...
# The lowest-cost GPT-6 family model. Every demo refuses a model outside the family.
# gpt-6-luna: $0.10 in, $0.50 out per million tokens (25 Nov 2026). A run costs well under a cent.
OPENAI_MODEL=gpt-6-luna

# --- the estate: one AWS account, ap-southeast-2 -----------------------------------------
# The demos give these to the StackQL MCP server process and to nothing else. The model never
# sees them. Leave them out of this file if they are already in your environment.
# talk-1 needs ssm:PutParameter, ssm:GetParametersByPath and ssm:DeleteParameter.
# talk-2 needs dynamodb:CreateTable, DescribeTable, UpdateTable and DeleteTable.
# talk-3 needs both sets: a table called customers and one parameter, /ops-notes/customers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- optional ------------------------------------------------------------------------------
# cap on model steps per run
AGENT_MAX_STEPS=8
# where the StackQL MCP server caches providers. Empty: ~/.stackql
STACKQL_APPROOT=
# a stackql binary to use instead of the one the npm launcher downloads on first run
STACKQL_MCP_BIN=
