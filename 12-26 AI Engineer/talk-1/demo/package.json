{
  "name": "query-before-mutation-talk-1-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A release agent at the gate: the OpenAI SDK (Responses API), the StackQL MCP server over stdio from npm, and a release policy in code",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "stage": "node src/stage.ts",
    "blocked": "node src/agent.ts blocked",
    "promote": "node src/agent.ts promote",
    "note": "node src/agent.ts note",
    "agent": "node src/agent.ts",
    "audit": "node src/audit.ts",
    "tools": "node src/agent.ts --tools",
    "replay": "node src/replay.ts",
    "teardown": "node src/stage.ts --teardown",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stackql/mcp-server": "1.1.959",
    "openai": "7.64.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
