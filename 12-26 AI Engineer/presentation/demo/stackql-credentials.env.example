# Copy to stackql-credentials.env. Read by StackQL only (--env.file); never
# loaded into the agent process or sent to the model.

# awscc provider
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# cloudflare provider (scope the token to the stackql.xyz zone)
CLOUDFLARE_API_TOKEN=

# entra_id provider (app registration, client credentials)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
