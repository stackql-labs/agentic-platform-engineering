/*+ exists */
SELECT COUNT(*) AS count FROM k8s.core.namespaces
WHERE cluster_addr = '{{ cluster_addr }}'
  AND protocol = '{{ protocol }}'
  AND json_extract(metadata, '$.name') = '{{ name }}'

/*+ create */
INSERT INTO k8s.core.namespaces(cluster_addr, protocol, metadata)
SELECT
  '{{ cluster_addr }}',
  '{{ protocol }}',
  '{"name": "{{ name }}", "labels": {"{{ demo_label_key }}": "{{ demo_label_value }}", "managed-by": "stackql-deploy"}}'

/*+ statecheck, retries=5, retry_delay=3 */
SELECT COUNT(*) AS count FROM k8s.core.namespaces
WHERE cluster_addr = '{{ cluster_addr }}'
  AND protocol = '{{ protocol }}'
  AND json_extract(metadata, '$.name') = '{{ name }}'
  AND json_extract(status, '$.phase') = 'Active'
  AND json_extract(metadata, '$.labels.{{ demo_label_key }}') = '{{ demo_label_value }}'

/*+ exports */
SELECT '{{ name }}' AS namespace
