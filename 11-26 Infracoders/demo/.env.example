# copy to .env and fill in. The scripts source it and the agent loads it itself.
# stackql-deploy reads each cell's own file (cells/<cell>.env), which holds no secrets.
# Never commit .env.

# --- the model: OpenAI through the Vercel AI SDK (Responses API) ----------------
OPENAI_API_KEY=sk-...
# gpt-6.1-sol keeps a live run short
OPENAI_MODEL=gpt-6.1-sol

# --- the estate: one AWS account you can make three small things in -------------
# The demo creates, per cell (ap-southeast-2, us-west-2, eu-central-1): one on-demand
# DynamoDB table called `orders` and one SSM parameter called `/orders/release`.
# The identity needs dynamodb:CreateTable/DescribeTable/ListTables/UpdateTable/DeleteTable,
# ssm:PutParameter/GetParametersByPath/DeleteParameter and cloudtrail:LookupEvents,
# and nothing else. It lives in the stackql processes, never in the model's context.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- optional ---------------------------------------------------------------------
# the stackql-deploy entry point. Empty: `stackql-deploy` on the PATH
STACKQL_DEPLOY=
# the stackql binary the agent starts as its MCP server. Empty: `stackql` on the PATH
STACKQL_BIN=
# where the stack's providers are pulled to. Empty: .stackql under the demo root, which is
# where stackql-deploy puts them on the first build
STACKQL_APPROOT=
# the audit sink (one JSON record per tool call) and the transcripts. Empty: agent/audit
STACKQL_AUDIT_DIR=
# cap on model steps per run
AGENT_MAX_STEPS=14
# how long one of the gate's own checks of a cell stays good for, in seconds
GATE_FRESHNESS_SECONDS=600
