{
  "name": "rollout-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A release agent: Vercel AI SDK + OpenAI, the StackQL MCP server for reads, stackql-deploy behind a policy gate for writes",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "agent": "tsx src/agent.ts",
    "tools": "tsx src/agent.ts --list-tools",
    "gate": "tsx src/agent.ts --gate",
    "replay": "tsx src/agent.ts --replay",
    "audit": "tsx src/audit.ts",
    "test": "tsx --test test/policy.test.ts test/cells.test.ts test/deploy.test.ts test/console.test.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.85",
    "@ai-sdk/openai": "4.0.102",
    "ai": "7.0.154"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.20.0",
    "typescript": "5.9.3"
  }
}
