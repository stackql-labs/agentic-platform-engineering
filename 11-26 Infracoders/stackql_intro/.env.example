# copy to .env, fill in, then `source .env` before stackql-deploy or stackql shell.
# Never commit .env.

# AWS: an identity that can launch and terminate one EC2 instance in ap-southeast-2
# and read EC2 (instances, instance status, network interfaces, tags) and SSM public parameters
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=

# Cloudflare: a token with Zone > DNS > Edit on one zone you do not mind adding four A records to
export CLOUDFLARE_API_TOKEN=
export CLOUDFLARE_ZONE_ID=
export CLOUDFLARE_ZONE_NAME=example.com

# GitHub: a username and a personal access token (public read is enough)
export STACKQL_GITHUB_USERNAME=
export STACKQL_GITHUB_PASSWORD=
