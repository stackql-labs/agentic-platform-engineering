/*+ exists */
SELECT id AS record_id
FROM cloudflare.dns.zones_dns_records
WHERE zone_id = '{{ zone_id }}'
  AND name    = '{{ host }}.{{ zone_name }}'
  AND type    = 'A'

/*+ create */
INSERT INTO cloudflare.dns.zones_dns_records (
  zone_id,
  name,
  type,
  content,
  ttl,
  proxied,
  comment
)
SELECT
  '{{ zone_id }}',
  '{{ host }}',
  'A',
  '{{ target_ip }}',
  300,
  false,
  '{{ owner_repo }}'

/*+ statecheck, retries=3, retry_delay=2 */
SELECT COUNT(*) AS count
FROM cloudflare.dns.zones_dns_records
WHERE zone_id = '{{ zone_id }}'
  AND name    = '{{ host }}.{{ zone_name }}'
  AND type    = 'A'
  AND content = '{{ target_ip }}'
  AND comment = '{{ owner_repo }}'

/*+ update */
UPDATE cloudflare.dns.zones_dns_records
SET name    = '{{ host }}',
    type    = 'A',
    content = '{{ target_ip }}',
    ttl     = 300,
    comment = '{{ owner_repo }}'
WHERE zone_id       = '{{ zone_id }}'
  AND dns_record_id = '{{ this.record_id }}'

/*+ delete */
DELETE FROM cloudflare.dns.records
WHERE zone_id       = '{{ zone_id }}'
  AND dns_record_id = '{{ this.record_id }}'
