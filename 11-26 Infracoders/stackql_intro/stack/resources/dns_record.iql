/*+ exists */
SELECT id AS record_id
FROM cloudflare.dns.zones_dns_records
WHERE zone_id = '{{ zone_id }}'
  AND name    = '{{ host }}.{{ zone_name }}'
  AND type    = 'A'

/*+ create */
INSERT INTO cloudflare.dns.zones_dns_records (
  zone_id,
  data__name,
  data__type,
  data__content,
  data__ttl,
  data__proxied,
  data__comment
)
SELECT
  '{{ zone_id }}',
  '{{ host }}',
  'A',
  '{{ target_ip }}',
  300,
  false,
  '{{ owner_repo }}'

/*+ statecheck, retries=3, retry_delay=2 */
SELECT COUNT(*) AS count
FROM cloudflare.dns.zones_dns_records
WHERE zone_id = '{{ zone_id }}'
  AND name    = '{{ host }}.{{ zone_name }}'
  AND type    = 'A'
  AND content = '{{ target_ip }}'
  AND comment = '{{ owner_repo }}'

/*+ update */
UPDATE cloudflare.dns.records
SET data__name    = '{{ host }}',
    data__type    = 'A',
    data__content = '{{ target_ip }}',
    data__ttl     = 300,
    data__comment = '{{ owner_repo }}'
WHERE zone_id       = '{{ zone_id }}'
  AND dns_record_id = '{{ this.record_id }}'

/*+ delete */
DELETE FROM cloudflare.dns.records
WHERE zone_id       = '{{ zone_id }}'
  AND dns_record_id = '{{ this.record_id }}'
