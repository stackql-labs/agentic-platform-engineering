/*+ exists */
SELECT json_array_length(rules) AS count
FROM cloudflare.rulesets.phases
WHERE zone_id       = '{{ zone_id }}'
  AND ruleset_phase = '{{ ruleset_phase }}'

/*+ createorupdate */
REPLACE cloudflare.rulesets.phases
SET rules = '[
  {
    "action": "block",
    "description": "{{ description }}",
    "enabled": true,
    "expression": "(starts_with(http.request.uri.path, \\"/\\"))",
    "ratelimit": {
      "characteristics": ["ip.src", "cf.colo.id"],
      "period": {{ period }},
      "requests_per_period": {{ threshold }},
      "mitigation_timeout": {{ period }}
    }
  }
]'
WHERE zone_id       = '{{ zone_id }}'
  AND ruleset_phase = '{{ ruleset_phase }}'

/*+ statecheck, retries=2, retry_delay=3 */
SELECT COUNT(*) AS count FROM (
  SELECT json_extract(rules, '$[0].description') AS description,
         json_extract(rules, '$[0].ratelimit.requests_per_period') AS threshold,
         json_extract(rules, '$[0].ratelimit.period') AS period,
         json_extract(rules, '$[0].enabled') AS enabled
  FROM cloudflare.rulesets.phases
  WHERE zone_id       = '{{ zone_id }}'
    AND ruleset_phase = '{{ ruleset_phase }}'
) t
WHERE t.description = '{{ description }}'
  AND t.threshold   = {{ threshold }}
  AND t.period      = {{ period }}
  AND t.enabled     = 1

/*+ exports */
SELECT json_extract(rules, '$[0].id') AS rate_limit_rule_id
FROM cloudflare.rulesets.phases
WHERE zone_id       = '{{ zone_id }}'
  AND ruleset_phase = '{{ ruleset_phase }}'

/*+ delete */
REPLACE cloudflare.rulesets.phases
SET rules = '[]'
WHERE zone_id       = '{{ zone_id }}'
  AND ruleset_phase = '{{ ruleset_phase }}'
