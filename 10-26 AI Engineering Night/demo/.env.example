# copy to .env and fill in. The scripts source it; stackql-deploy reads it with
# --env-file .env; the agent loads it itself. Never commit .env.

# --- the model: OpenAI through the Vercel AI SDK --------------------------------
OPENAI_API_KEY=sk-...
# gpt-6.1-sol keeps a live run short; gpt-6-astra for a more careful report
OPENAI_MODEL=gpt-6.1-sol

# --- the estate: one Cloudflare zone, a throwaway one ---------------------------
# a token scoped to THIS zone only: Zone > Zone WAF > Edit, Zone > Zone > Read,
# Account > Account Analytics > Read (for the traffic query). Nothing else.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# printed by every script so the room (and you) can see which zone is in play
CLOUDFLARE_ZONE_NAME=stackql.xyz

# --- the declaration's home on GitHub, for the provenance query ------------------
# public repo, no token needed. owner/repo and the path of the manifest in it
DECLARATION_REPO=stackql-labs/agentic-platform-engineering
DECLARATION_PATH="10-26 AI Engineering Night/demo/stack/stackql_manifest.yml"

# --- the platform: StackQL MCP server -------------------------------------------
# read_only: writes refused by the server. safe: writes pause for operator approval.
# The agent code never starts a full_access server.
STACKQL_MCP_MODE=read_only
# where providers are pulled to; cloudflare and github must be there. Empty: stackql's own
# default (~/.stackql), and no --approot is passed
STACKQL_APPROOT=
# the stackql binary the MCP launcher runs. Empty: `stackql` on the PATH, nothing downloaded
STACKQL_MCP_BIN=
# the server's audit sink (one JSON record per tool call), the transcripts and the last
# proposal. Empty: audit/ under the directory the agent runs from (agent/audit with npm run)
STACKQL_AUDIT_DIR=
# cap on model steps per run
AGENT_MAX_STEPS=12
# the stackql-deploy entry point. Empty: `stackql-deploy` on the Git Bash PATH
STACKQL_DEPLOY=
