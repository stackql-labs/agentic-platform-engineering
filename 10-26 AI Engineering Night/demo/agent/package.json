{
  "name": "edge-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A scheduled platform agent: Vercel AI SDK + OpenAI + the StackQL MCP server, behind a policy gate",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "agent": "tsx src/agent.ts",
    "tools": "tsx src/agent.ts --list-tools",
    "probe": "tsx src/agent.ts --probe-write",
    "replay": "tsx src/agent.ts --replay",
    "audit": "tsx src/audit.ts",
    "test": "tsx --test test/policy.test.ts test/declaration.test.ts test/console.test.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.85",
    "@ai-sdk/openai": "4.0.102",
    "@stackql/mcp-server": "0.12.824",
    "ai": "7.0.154",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.20.0",
    "typescript": "5.9.3"
  }
}
